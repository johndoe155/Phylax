+/** Click state for the round arrow buttons. `trigger()` latches `active` on and releases it after `ms`, which covers the
+ *  smooth scroll the click starts; clicking again restarts the timer, and the timer is cleared on unmount. */
+function useTimedActive(ms = 900) {
+  const [active, setActive] = useState(false);
+  const timer = useRef<number | undefined>(undefined);
+  const trigger = useCallback(() => {
+    setActive(true);
+    window.clearTimeout(timer.current);
+    timer.current = window.setTimeout(() => setActive(false), ms);
+  }, [ms]);
+  useEffect(() => () => window.clearTimeout(timer.current), []);
+  return [active, trigger] as const;
+}
