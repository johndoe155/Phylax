# ================================================================================================
# Phylax — the environment
#
# Copy this file to `.env` (for development) or `/etc/phylax/phylax.env` (on the server), and fill it in.
# Application values below; root-only backup secrets belong in deploy/backup.env.example.
#
# The server validates this file on start and refuses to run in production if something important is missing
# or wrong, so a mistake shows up immediately rather than as a strange error later.
# ================================================================================================

# ---- the basics ------------------------------------------------------------------------------
# development | production | test
NODE_ENV=production

# The port the Express server listens on. Behind the reverse proxy this stays internal.
PORT=3000

# The interface to listen on. 127.0.0.1 when nginx (or Caddy) is in front; 0.0.0.0 when it is not.
HOST=127.0.0.1

# The public address of the site. This is what the one-time links point at, and what the passkey origin check
# expects. It must be the address people actually type, with no trailing slash: https://phylax.example.com
APP_URL=https://phylax.example.com

# The timezone the server reports times in. The scheduler uses each account's own timezone for its messages.
TZ=UTC

# error | warn | info | debug
LOG_LEVEL=info

# Set to true when the server is behind a proxy (nginx, Cloudflare) so the real client address is read from
# the X-Forwarded-For header, and the rate limiter counts each person rather than the proxy.
TRUST_PROXY=true
# Refresh Cloudflare's published proxy address ranges at runtime (both lists must validate before an atomic swap).
CLOUDFLARE_IPS_REFRESH=true
CLOUDFLARE_IPS_URL_V4=https://www.cloudflare.com/ips-v4
CLOUDFLARE_IPS_URL_V6=https://www.cloudflare.com/ips-v6
CLOUDFLARE_IPS_REFRESH_MS=86400000
# Production with TRUST_PROXY=true requires nginx Authenticated Origin Pulls (mTLS), not just the shared CF IP list.
# Install the official Cloudflare Origin Pull CA at this path, enable ssl_verify_client in nginx, then set true.
REQUIRE_AUTHENTICATED_ORIGIN_PULLS=false
CF_ORIGIN_CA_CERT=
# Host-monitoring thresholds. The release gate requires the public URL and (by default) an external dead-man URL.
MONITOR_PUBLIC_URL=https://phylax.example.com
MONITOR_DISK_WARN_PERCENT=85
MONITOR_CERT_MIN_DAYS=14
MONITOR_PG_MAX_CONN_PERCENT=80
REQUIRE_EXTERNAL_PING=true
EXTERNAL_PING_URL=


# ---- the database ----------------------------------------------------------------------------
# PostgreSQL 15 or later, on the same machine.
#
# The choice: PostgreSQL runs LOCALLY on the Oracle VM, not on a managed service. It costs nothing, there is no
# latency between the app and its data, and there is no free tier to expire. The trade-off is that the data
# lives on the machine that can be reclaimed, which is why deploy/backup.sh copies it off the machine
# daily, plus WAL when PITR is configured. See docs/RELEASE-REMEDIATION.md.
#
# The password below is a placeholder. Generate a real one:
#   openssl rand -base64 32
DATABASE_URL=postgresql://phylax:CHANGE_ME@127.0.0.1:5432/phylax
# Do NOT put DATABASE_MIGRATION_URL here: this file is read by the long-running service. Provisioning creates
# /etc/phylax/migrator.env (root:root 0600); redeploy loads it only for --migrate-only. The app starts --no-migrate.

# How long the pool waits for a connection before giving up, in milliseconds.
DATABASE_POOL_MAX=10
# The SEPARATE advisory-lock pool. Advisory locks are session-scoped in PostgreSQL, so a connection that holds
# one cannot hand it to anybody else: the scheduler's leadership lock, each dispatch worker's account guard and
# each account-mutating HTTP request all pin a connection for as long as they hold the lock. It was hard-coded at
# 12, which was smaller than the sum of those on a busy box — HTTP drained it, the scheduler could not acquire,
# and mutations answered an opaque 503 that reads like a database outage and is not one. Must be >= the pool
# above; the number of scheduler dispatch workers is DERIVED from this value (see db.ts dispatchWorkerBudget).
DATABASE_LOCK_POOL_MAX=16
# How long an account-write guard waits for a lock-pool connection. On timeout the request gets a retryable 409
# (lock_pool_busy) with Retry-After, not an opaque 503 — pool saturation is contention, not a database outage.
DATABASE_LOCK_ACQUIRE_TIMEOUT_MS=4000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_SSL=false

# Where the .sql migration files live. Leave this alone unless the server is not where you think it is.
# MIGRATIONS_DIR=/opt/phylax/current/dist/migrations


# ---- sessions and cookies --------------------------------------------------------------------
# A long random string. It signs the short-lived values (the one-time links, the OAuth state, the pending
# sign-up cookie). If it leaks, an attacker can forge those. Generate one and keep it out of the repository:
#   openssl rand -hex 32
#
# There is deliberately NO usable default here. The server refuses to start in production with a value that
# looks like an unreplaced placeholder (CHANGE_ME..., your-secret..., xxxx..., a single repeated character, or
# fewer than 64 digits), because a length rule alone accepted the 56-character literal this file used to ship —
# and that literal is in the public repository.
SESSION_SECRET=
# Optional, and if set it must also not look like a placeholder:
# OPS_TOKEN=            # openssl rand -hex 24
# DATABASE_HASH_KEY=    # openssl rand -hex 32  (REQUIRED in production; see below)

# How long a sign-in may stay IDLE before it expires, in minutes. 0 = no idle timeout (the absolute
# SESSION_TTL_DAYS still applies). Without this, a cookie lifted from a machine stays valid for up to a year
# whether or not anybody is using it. 10080 = one week. When enabled it must be at least 2 minutes: session
# activity is recorded at most once a minute, so a shorter window would sign out people who are actively using it.
SESSION_IDLE_TIMEOUT_MINUTES=10080

# The key the PRE-MIGRATION BACKUP RECEIPT is HMAC'd with. REQUIRED in production.
#
# The receipt has to be readable by the service user (it runs the boot-time migration gate) and it carries a
# digest of DATABASE_URL. As a bare sha256 of a low-entropy database password in a world-readable file that is a
# brute-force target. Set the SAME value here and in the root-only /etc/phylax/backup.env; deploy/db-hash.mjs is
# the one derivation, and `npm test` pins it against server/db.ts. Generate one:
#   openssl rand -hex 32
DATABASE_HASH_KEY=

# The key RECIPIENT identifiers are HMAC'd with: delivery suppressions and per-recipient rate budgets.
#
# This used to be SESSION_SECRET, which made a secret rotation a silent data-loss event — delivery_suppressions is
# keyed by the hash, so a rebuilt machine with a new SESSION_SECRET stops matching every existing suppression and
# starts texting people who replied STOP. Decoupling it means the session secret can be rotated freely.
# Leave EMPTY to keep using SESSION_SECRET (an existing deployment keeps matching what it has already stored).
# For rotation: generate a fresh key, set it here, and add every old key to IDENTIFIER_HASH_PREVIOUS_KEYS.
# IMPORTANT: suppression rows are one-way HMACs; the original address is intentionally not stored, so old rows
# cannot be re-keyed. Keep previous keys in the encrypted DR copy for as long as any such suppression may exist.
IDENTIFIER_HASH_KEY=
# Comma-separated earlier keys, still honoured for lookups; remove ONLY when every matching suppression is gone.
# IDENTIFIER_HASH_PREVIOUS_KEYS=
# Safe inventory (prints key fingerprints and row counts, never the keys or addresses):
#   node scripts/phylax-ops.mjs identifiers keys
# Signing key for one-click unsubscribe links. Defaults to IDENTIFIER_HASH_KEY; not SESSION_SECRET, because
# rotating the session secret would invalidate every unsubscribe link already in an inbox.
# UNSUBSCRIBE_TOKEN_KEY=

# How long a sign-in lasts, in days.
SESSION_TTL_DAYS=365

# The cookie is marked Secure in production. Set this to false ONLY when testing over plain HTTP.
COOKIE_SECURE=true

# SameSite=Lax is right for a site that does not need the cookie inside a third-party iframe.
COOKIE_SAME_SITE=lax

# Leave this empty unless the cookie has to be scoped to a parent domain.
# COOKIE_DOMAIN=.example.com


# ---- passkeys (WebAuthn) ---------------------------------------------------------------------
# The passkey's "relying party" id. It is the domain, without the scheme and without a path.
# For a site at https://phylax.example.com this is phylax.example.com, and it must be a domain the page is
# actually served from. A subdomain cannot register a passkey for its parent.
RP_ID=phylax.example.com

# The origin the passkey ceremony is checked against. It is derived from APP_URL when this is left empty.
# RP_ORIGIN=https://phylax.example.com

# The name the device shows for the passkey.
RP_NAME=Phylax


# ---- sign-in with Google ---------------------------------------------------------------------
# Create the client at https://console.cloud.google.com/apis/credentials
# The authorised redirect URI must be exactly: https://phylax.example.com/api/auth/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ---- sign-in with Apple ----------------------------------------------------------------------
# Create the client at https://developer.apple.com/account/resources/identifiers/list/serviceId
# The redirect URI must be exactly: https://phylax.example.com/api/auth/oauth/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The contents of the .p8 key file, as one line, with the newlines written as \n
APPLE_PRIVATE_KEY=


# ---- email -----------------------------------------------------------------------------------
# disabled | log (development only) | resend | postmark | smtp
#
# `log` writes the message to the log and to a file instead of sending it. It is the default because it needs
# no account and no key, which means a fresh install works. Set a real provider before going live.
MAIL_PROVIDER=disabled

# The address the messages come from. Validated on start-up: it must be a well-formed From header, and in
# production the domain may not be an example/test/localhost domain — no provider will relay mail from a domain
# you do not own, and the failure would otherwise arrive at runtime on the first sign-in link.
MAIL_FROM=no-reply@YOUR-SENDING-DOMAIN
MAIL_REPLY_TO=

# resend
RESEND_API_KEY=

# postmark
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM=outbound

# smtp (nodemailer is included)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Require an upgraded TLS session before handing mail to the relay. Without it, port 587 uses OPPORTUNISTIC
# STARTTLS: a relay that does not advertise it receives the message — including sign-in links and verification
# codes — in clear text, and nothing reports that it happened. Production refuses to boot with both this and
# SMTP_SECURE off. Set false only for a relay on a trusted private network that genuinely has no TLS.
SMTP_REQUIRE_TLS=true


# ---- text messages ---------------------------------------------------------------------------
# disabled | log (development only) | twilio | webhook
#
# `log` writes the message to the log and to a file instead of sending it.
SMS_PROVIDER=disabled

# twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM=

# a generic webhook: the message is POSTed as JSON to this address
SMS_WEBHOOK_URL=


# ---- the reminder scheduler -------------------------------------------------------------------
# The scheduler runs inside the Express process. It ticks once a minute, works out what each account should be
# told, and sends it. It is guarded by a Postgres advisory lock, so a second copy of the process cannot send
# the same reminder twice.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
# How long before a cancellation window closes the reminder goes out, in minutes.
REMINDER_LEAD_MINUTES=180


# ---- operations -------------------------------------------------------------------------------
# A shared secret for the /api/ops/* endpoints: the status endpoint, the "run the scheduler now" endpoint, and
# replay/acknowledge and delivery probes. There is deliberately no HTTP shell-backup trigger. Generate one:
#   openssl rand -hex 24
OPS_TOKEN=

# Synthetic keepalive is not installed and cannot guarantee protection from OCI reclaim.

# ---- operator/legal approval (required in production; enter actual reviewed values) ------------
# SERVICE_OPERATOR="Your actual operating entity"
# SERVICE_CONTACT_EMAIL=your-real-support-address@your-domain
# SERVICE_JURISDICTION="Actual applicable jurisdiction"
# LEGAL_APPROVED_VERSION=2026-10-17.2

# How the release gate proves mail actually delivers.
#
#   callback  an authenticated provider webhook (Resend's Svix signature, Postmark's token). This is the default
#             and the stronger proof.
#   probe     an operator-confirmed POST /api/ops/probe delivery instead.
#
# `probe` exists because SMTP was effectively unusable in production: the gate demanded SMTP_WEBHOOK_TOKEN, an
# authenticated delivery callback that NO ordinary SMTP relay provides, so a perfectly good relay could never be
# accepted. Ordinary SMTP relays should set MAIL_DELIVERY_EVIDENCE=probe.
MAIL_DELIVERY_EVIDENCE=callback
RESEND_WEBHOOK_SECRET=
POSTMARK_WEBHOOK_TOKEN=
# Optional. Only set it if your relay genuinely posts delivery callbacks back to /api/webhooks/smtp.
SMTP_WEBHOOK_TOKEN=
SMS_WEBHOOK_TOKEN=
# Explicit approved prefixes are required when SMS is enabled. Example only: +234,+1
SMS_ALLOWED_PREFIXES=
# SMS limits count estimated billable segments, not just requests. Also set provider-side spending caps.
SMS_DAILY_LIMIT=100
SMS_RECIPIENT_DAILY_LIMIT=10
# Per-IP ceiling on phone-verification texts, per day. The account-scoped budget (3/day) was the only per-actor
# limit, and a passkey-only sign-up needs no email — so a fresh, legitimately-authenticated account could spend
# 3 SMS a day to ANY allowed-prefix number. This is the missing per-source budget.
SMS_VERIFICATION_IP_DAILY_LIMIT=10
# Minimum account age before SMS may be requested, in hours. 0 disables. SMS pumping is profitable within
# minutes of an account existing; a real person is not verifying a phone number in their first hour.
SMS_MIN_ACCOUNT_AGE_HOURS=1
# Cloudflare Turnstile, for the anonymous endpoints that cost money or unlock an enumeration oracle. Secret
# empty = the check is skipped. Secret set = anonymous auth POSTs that trigger an outbound message must carry a
# valid token. ENFORCE=false runs it in observe mode: failures are logged, not refused.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_ENFORCE=true
# Reject a password that appears in a public breach corpus (Have I Been Pwned, k-anonymity: only the first five
# hex characters of the SHA-1 ever leave the machine). Off by default because it is a third-party call; it fails
# OPEN on any provider error, so turning it on cannot lock anybody out during an outage.
PASSWORD_BREACH_CHECK=false
PASSWORD_BREACH_TIMEOUT_MS=3000
# The k-anonymity range endpoint. Leave as-is for Have I Been Pwned; point it at a self-hosted mirror or an egress
# proxy if the box may not reach the public internet. Only a 5-character SHA-1 prefix is ever sent.
PASSWORD_BREACH_URL=https://api.pwnedpasswords.com/range/
MAIL_DAILY_LIMIT=1000
SCHEDULER_BATCH_SIZE=80
SCHEDULER_ACCOUNT_BATCH=100

# Node >=22.12 is required. The OCI provisioner defaults to Node 24.
# DATABASE_SSL=true verifies the server certificate; use NODE_EXTRA_CA_CERTS for a private CA if needed.
# OAuth provider redirect URI: https://YOUR_DOMAIN/api/auth/oauth/callback
