# Copy to /etc/phylax/backup.env, root:root 0600. NEVER to the app-readable environment.
#
# The key the pre-migration backup receipt is hashed with. It must be set to the SAME value in
# /etc/phylax/phylax.env (the app derives the same hash to check the receipt) — otherwise a perfectly good backup
# is rejected as tampered, and production refuses to migrate. The app and the backup tool each fall back to the
# plain digest of DATABASE_URL when it is unset, which is why receipts written before this existed still work;
# the plain digest is a brute-forceable sha256 of a low-entropy URL, so set the key.
# DATABASE_HASH_KEY=<same 32+ byte random value as in /etc/phylax/phylax.env>

# The dead-man's switch. monitor.sh pings this HTTPS endpoint when every check passes; an external service that
# stops hearing from it raises the alarm. Without it, a silently dead scheduler looks exactly like a quiet week.
# EXTERNAL_PING_URL=https://your-operated-deadmans-switch/ping/<unique-id>
BACKUP_KEY_FILE=/etc/phylax/backup.key
BACKUP_DIR=/var/backups/phylax
BACKUP_KEEP=14
BACKUP_REMOTE_DAYS=30
BACKUP_S3_PREFIX=phylax
# Choose rclone OR S3. Configure root's rclone securely if using it.
# BACKUP_RCLONE_REMOTE=your-configured-remote
# BACKUP_S3_BUCKET=s3://your-real-bucket
# BACKUP_S3_ENDPOINT=https://your-real-s3-compatible-endpoint
# BACKUP_S3_ACCESS_KEY=...
# BACKUP_S3_SECRET_KEY=...
# BACKUP_S3_REGION=...
# Required production HTTPS failure-alert endpoint with independent credentials.
# BACKUP_ALERT_URL=https://your-operated-alert-endpoint
# BACKUP_ALERT_TOKEN=...
# Set by configure-pitr.sh only after real encrypted remote WAL setup succeeds.
PITR_ENABLED=false
# PITR setup variables are passed as root environment to deploy/oci/configure-pitr.sh.
# PITR_S3_BUCKET, PITR_S3_ENDPOINT (hostname, no scheme), PITR_S3_REGION,
# PITR_S3_KEY, PITR_S3_SECRET, PITR_CIPHER_PASSPHRASE (>=32 chars).
# Save BOTH the dump key and WAL passphrase/config independently OFF THIS VM.
